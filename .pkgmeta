# CurseForge / BigWigs packager (repo root -- not inside SmoreSkills/).
# Docs: https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File

package-as: SmoreSkills
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Nested addon: source in SmoreSkills/; packager finds TOC via move-folders (do not flatten in CI).
move-folders:
  SmoreSkills/SmoreSkills: SmoreSkills

ignore:
  - scripts
  - assets
  - Art
  - GUIDELINES.md
  - CAMPING.md
  - README.md
  - CHANGELOG.md
  - CURSEFORGE.md
  - .cursor
  - .gitignore
  - .github
